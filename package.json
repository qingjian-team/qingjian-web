{
	"name": "qingjian-web",
	"private": true,
	"version": "0.1.0",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "node scripts/sync-docs.mjs && node scripts/sync-releases.mjs && vite dev",
		"build": "node scripts/sync-docs.mjs && node scripts/sync-releases.mjs && wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/sync-docs.mjs && node scripts/sync-releases.mjs && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"sync-docs": "node scripts/sync-docs.mjs",
		"sync-releases": "node scripts/sync-releases.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"marked": "^18.0.11",
		"phosphor-svelte": "^3.1.0"
	}
}
